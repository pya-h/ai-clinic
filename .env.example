# ── General ──
APP_PORT=8080
# Swagger title (default: AI-Clinic)
APP_NAME=AI-Clinic
# "true" serves Swagger at /docs and returns detailed validation errors
DEBUG=true
# Runtime environment. Any value other than "production" (e.g. "development")
# DISABLES rate limiting — convenient for local dev, tests and data seeding.
# Set to "production" to enforce throttling (auth: 5/min, global: 100/min).
APP_ENV=development
# "production" adds the Secure flag to the session and CSRF cookies (HTTPS only)
# NODE_ENV=production

# ── Database ──
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_clinic

# ── Auth ──
AUTH_SALT_ROUNDS=12
SESSION_SECRET=your-strong-session-secret-min-32-chars
SESSION_COOKIE_NAME=sid

# ── Seed / Superuser ──
SUPERUSER_EMAIL=admin@ai-clinic.com
SUPERUSER_PASSWORD=SuperAdmin123!

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── AI ──
BOTAGENT_KEY=your-botpress-webhook-id
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo
# "sse" (default) streams Botpress replies; "poll" leaves fetching them to the client
# BOTPRESS_DELIVERY_MODE=sse

# ── Notifications ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=app-password
SMTP_FROM=AI-Clinic <noreply@ai-clinic.com>
VAPID_SUBJECT=mailto:admin@ai-clinic.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Calendly ──
CALENDLY_API_KEY=
CALENDLY_ORGANIZATION_URI=https://api.calendly.com/organizations/YOUR_ORG_UUID
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Storage ──
# Only "local" is implemented; "s3" falls back to local
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
